# Copy to keystore.properties at the repository root for local release builds.
# Never commit the real file: .gitignore excludes it.
#
# CI uses the equivalent environment variables instead:
#   ANDROID_KEYSTORE_PATH, ANDROID_KEYSTORE_PASSWORD, ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD
# plus ANDROID_KEYSTORE_BASE64, which the workflow decodes to a temporary file.
storeFile=/absolute/path/to/release.keystore
storePassword=change-me
keyAlias=studysynth
keyPassword=change-me
